# ============================================================
# BioChem — environment template
# Copy to `.env` (local) or configure in Vercel → Settings →
# Environment Variables. NEVER commit real keys to the repo.
# ============================================================

# ---- App -----------------------------------------------------
# Canonical URL of the deployment (no trailing slash).
NEXT_PUBLIC_APP_URL=http://localhost:3000

# ---- Supabase ------------------------------------------------
# Project Settings → API
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Server-only. Used by API routes for privileged operations
# (ingestion, queue processing, admin actions). Never expose.
SUPABASE_SERVICE_ROLE_KEY=

# ---- Aevibron AI Gateway --------------------------------------
# Base URL of the gateway (no trailing slash), e.g. https://gw.aevibron.example
AEVIBRON_GATEWAY_URL=
# API key sent as the `X-Aevibron-Key` header (server-side only).
AEVIBRON_API_KEY=
# Endpoint paths (defaults shown — override only if the contract changes).
AEVIBRON_CHAT_PATH=/api/v1/chat
AEVIBRON_STATUS_PATH=/api/v1/status
# Model routing per feature. Allowed models:
#   core-v3, swift-v1, quantum-v4, compound-v1/lite, allam-v2,
#   prime-v2/v3.1, flash-v2, flash-v3.5, lite-v2.5
AEVIBRON_MODEL_TUTOR=core-v3
AEVIBRON_MODEL_DAILY=swift-v1
AEVIBRON_MODEL_EXPLAIN=flash-v2
AEVIBRON_MODEL_PLAN=quantum-v4
AEVIBRON_MODEL_FLASHCARDS=compound-v1/lite
AEVIBRON_MODEL_COMMUNITY=allam-v2
# Request timeout (ms) before the gateway call is queued for retry.
AEVIBRON_TIMEOUT_MS=45000

# ---- Operations console (the ONLY administrator) ----------------
# There is no admin account in the database and no /admin route.
# The console lives at https://your-app.vercel.app/<ADMIN_ROUTE_PATH>
# and only these credentials unlock it. Choose an unguessable path
# (like a second password) and a long password. Vercel-only values.
ADMIN_ROUTE_PATH=            # e.g. panel-x7k29m (letters, numbers, dashes)
ADMIN_EMAIL=
ADMIN_PASSWORD=
# Random string that signs console session cookies (openssl rand -hex 32).
ADMIN_SESSION_SECRET=

# ---- Security -------------------------------------------------
# Shared secret for external cron pings (Cron-Job.org).
# Send as `Authorization: Bearer <CRON_SECRET>` on /api/cron/* routes.
CRON_SECRET=

# ---- Support desk ----------------------------------------------
# Optional webhook (Discord/Slack/custom) pinged the moment a new
# support ticket arrives. Leave empty to rely on the console inbox.
SUPPORT_WEBHOOK_URL=

# ---- Web Push (VAPID) -----------------------------------------
# Generate with: npm run generate:vapid
NEXT_PUBLIC_VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:admin@example.com

# ---- Digest & reminders ---------------------------------------
# Cron endpoints are pinged externally (see README → Scheduled jobs).
DIGEST_SEND_HOUR_UTC=18
